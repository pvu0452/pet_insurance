
# ==========================================
# WAS Insurance - Environment Configuration
# ==========================================
# Copy this file to .env.local and configure
# the variables for your environment.
#
# Do not commit actual API keys or secrets.

# Backend API
# Base URL for the WAS Insurance backend API.
# Verify whether this variable is still required.
NEXT_PUBLIC_API_URL=

# Google Maps
# Used for address search and autocomplete.
# Restrict the key to authorised websites.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe
# Server-side key for payment processing.
STRIPE_SECRET_KEY=

# Used to verify incoming Stripe webhook events.
STRIPE_WEBHOOK_SECRET=

# Resend
# Server-side key for sending emails.
RESEND_API_KEY=

# Application Base URL
# Local example: http://localhost:3000
# Deployment example: https://was-t124.vercel.app
NEXT_PUBLIC_BASE_URL=
